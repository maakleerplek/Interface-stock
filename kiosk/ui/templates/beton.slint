// Template 1 — BETON: close to maakleerplek.be. Beton page, white sheets,
// thin rules, flat ink buttons, Literata for prices and titles, agenda
// colours only as category pills.

import { Mk, Screen, Category, CartRow, ProductTile, Press } from "../tokens.slint";
export { Screen, Category, CartRow, ProductTile }

component Sheet inherits Rectangle {
    background: Mk.wit;
    border-radius: 16px;
    border-width: 1px;
    border-color: Mk.lijn;
}

component Card inherits Rectangle {
    in property <ProductTile> item;
    callback picked(int);

    accessible-role: button;
    accessible-label: root.item.name;
    background: touch.pressed ? Mk.beton-donker : Mk.wit;
    border-radius: 14px;
    border-width: root.item.in-cart > 0 ? 3px : 1px;
    border-color: root.item.in-cart > 0 ? Mk.inkt : Mk.lijn;
    opacity: root.item.sold-out ? 0.45 : 1;
    clip: true;

    VerticalLayout {
        padding: 12px;
        spacing: 6px;
        Rectangle {
            height: 78px;
            if root.item.has-image: Image {
                height: parent.height;
                width: parent.width;
                source: root.item.image;
                image-fit: contain;
            }
            if !root.item.has-image: Rectangle {
                border-radius: 10px;
                background: root.item.light;
                Text {
                    text: root.item.initials;
                    color: root.item.deep;
                    font-family: Mk.serif;
                    font-size: 40px;
                    font-weight: 700;
                }
            }
        }
        Text {
            text: root.item.name;
            color: Mk.inkt;
            font-family: Mk.sans;
            font-size: 18px;
            font-weight: 600;
            wrap: word-wrap;
            overflow: elide;
            height: 44px;
            vertical-alignment: top;
        }
        HorizontalLayout {
            height: 34px;
            spacing: 8px;
            Text {
                text: root.item.sold-out ? "Sold out" : root.item.price;
                color: root.item.sold-out ? Mk.rood : Mk.inkt;
                font-family: root.item.sold-out ? Mk.sans : Mk.serif;
                font-size: root.item.sold-out ? 18px : 26px;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Rectangle {
                width: 14px;
                height: 14px;
                y: (parent.height - 14px) / 2;
                border-radius: 7px;
                background: root.item.deep;
            }
        }
    }

    if root.item.in-cart > 0: Rectangle {
        x: parent.width - 46px;
        y: 10px;
        width: 36px;
        height: 36px;
        border-radius: 18px;
        background: Mk.inkt;
        Text {
            text: root.item.in-cart;
            color: Mk.wit;
            font-family: Mk.sans;
            font-size: 18px;
            font-weight: 800;
        }
    }

    touch := TouchArea {
        enabled: !root.item.sold-out;
        clicked => { root.picked(root.item.pk); }
    }
}

component Lines inherits Rectangle {
    in property <[CartRow]> rows;
    in property <bool> editable;
    property <length> row-h: root.editable ? 84px : 56px;
    callback inc(int);
    callback dec(int);
    clip: true;

    flick := Flickable {
        content-height: root.rows.length * root.row-h;
        for row[i] in root.rows: Rectangle {
            y: i * root.row-h;
            height: root.row-h;
            HorizontalLayout {
                spacing: 12px;
                padding-top: 8px;
                padding-bottom: 8px;
                Rectangle {
                    width: 44px;
                    height: 44px;
                    y: (parent.height - 44px) / 2;
                    border-radius: 22px;
                    background: Mk.beton;
                    Text {
                        text: row.qty + "×";
                        color: Mk.inkt;
                        font-family: Mk.sans;
                        font-size: 18px;
                        font-weight: 800;
                    }
                }
                if root.editable: VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    Text {
                        text: row.name;
                        color: Mk.inkt;
                        font-family: Mk.sans;
                        font-size: 18px;
                        font-weight: 600;
                        overflow: elide;
                    }
                    Text {
                        text: row.price;
                        color: Mk.grafiet;
                        font-family: Mk.serif;
                        font-size: 20px;
                        font-weight: 700;
                    }
                }
                if !root.editable: Text {
                    horizontal-stretch: 1;
                    text: row.name;
                    color: Mk.inkt;
                    font-family: Mk.sans;
                    font-size: 20px;
                    font-weight: 600;
                    overflow: elide;
                    vertical-alignment: center;
                }
                if !root.editable: Text {
                    text: row.price;
                    color: Mk.inkt;
                    font-family: Mk.serif;
                    font-size: 22px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                if root.editable: Press {
                    text: "−";
                    width: 60px;
                    min-height: 60px;
                    radius: 30px;
                    fill: Mk.wit;
                    ink: Mk.inkt;
                    outline: Mk.lijn;
                    font-size: 30px;
                    accessible-label: "minus " + row.name;
                    clicked => { root.dec(i); }
                }
                if root.editable: Press {
                    text: "+";
                    width: 60px;
                    min-height: 60px;
                    radius: 30px;
                    font-size: 30px;
                    accessible-label: "plus " + row.name;
                    clicked => { root.inc(i); }
                }
            }
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Mk.lijn;
            }
        }
    }

    if flick.content-height > flick.height && -flick.content-y < flick.content-height - flick.height - 1px: Rectangle {
        y: parent.height - 30px;
        height: 30px;
        border-radius: 15px;
        background: Mk.beton-donker;
        Text {
            text: "↓ more — swipe up";
            color: Mk.grafiet;
            font-family: Mk.sans;
            font-size: 16px;
            font-weight: 600;
        }
    }
}

// Centred white sheet with a serif title, used by every dialog screen.
// Fills the body; the children land inside the sheet.
component Dialog inherits Rectangle {
    in property <string> title;
    in property <color> band: Mk.beton;
    Sheet {
        width: 1000px;
        x: (root.width - self.width) / 2;
        y: 24px;
        height: root.height - 48px;
        clip: true;
        Rectangle {
            height: 96px;
            y: 0;
            background: root.band;
            Text {
                x: 40px;
                text: root.title;
                color: Mk.inkt;
                font-family: Mk.serif;
                font-size: 44px;
                font-weight: 700;
            }
        }
        Rectangle {
            y: 96px;
            height: parent.height - 96px;
            @children
        }
    }
}

export component AppWindow inherits Window {
    title: "interface-stock";
    width: 1280px;
    height: 720px;
    background: Mk.beton;
    default-font-family: Mk.sans;

    in property <Screen> screen: Screen.shop;
    in property <string> htl-name;
    in property <string> message;
    in property <bool> message-error;
    in property <string> searching;
    in property <[CartRow]> rows;
    in property <int> units;
    in property <string> total;
    in property <bool> volunteer;
    in property <image> qr;
    in property <string> cart-categories;
    in property <string> done-summary;
    in property <[Category]> categories;
    in-out property <string> category: "ALL";
    in property <[ProductTile]> all-products;
    in property <[ProductTile]> products;

    callback action(string, int);
    callback pick(int);
    callback select-category(string);

    // --- top bar -----------------------------------------------------------
    Rectangle {
        y: 0;
        height: 76px;
        background: Mk.wit;
        Rectangle { y: parent.height - 1px; height: 1px; background: Mk.lijn; }
        HorizontalLayout {
            padding-left: 28px;
            padding-right: 16px;
            padding-top: 10px;
            padding-bottom: 10px;
            spacing: 18px;
            Image {
                source: @image-url("../assets/wordmark-ink.png");
                width: 210px;
                image-fit: contain;
            }
            Rectangle {
                horizontal-stretch: 1;
                if root.message != "": Rectangle {
                    width: min(parent.width, 620px);
                    height: 44px;
                    border-radius: 22px;
                    background: root.message-error ? Mk.rood : Mk.inkt;
                    Text {
                        width: parent.width - 32px;
                        text: root.message;
                        color: Mk.wit;
                        font-size: 19px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        overflow: elide;
                    }
                }
            }
            Text {
                text: "TV";
                color: Mk.grafiet;
                font-size: 18px;
                font-weight: 600;
                vertical-alignment: center;
            }
            Press {
                text: "‹";
                width: 56px;
                min-height: 56px;
                radius: 28px;
                fill: Mk.wit;
                ink: Mk.inkt;
                outline: Mk.lijn;
                font-size: 32px;
                accessible-label: "TV previous page";
                clicked => { root.action("page-prev", 0); }
            }
            Press {
                text: "›";
                width: 56px;
                min-height: 56px;
                radius: 28px;
                fill: Mk.wit;
                ink: Mk.inkt;
                outline: Mk.lijn;
                font-size: 32px;
                accessible-label: "TV next page";
                clicked => { root.action("page-next", 0); }
            }
        }
    }

    body := Rectangle {
        y: 76px;
        height: root.height - 76px;

        // --- shop ------------------------------------------------------------
        if root.screen == Screen.shop: HorizontalLayout {
            padding: 20px;
            spacing: 20px;
            VerticalLayout {
                width: 168px;
                spacing: 10px;
                for c in root.categories: Press {
                    text: c.name;
                    min-height: 60px;
                    radius: 30px;
                    font-size: 17px;
                    weight: 800;
                    fill: c.name == root.category ? c.deep : c.light;
                    ink: c.name == root.category ? Mk.wit : Mk.inkt;
                    accessible-label: c.name;
                    clicked => { root.select-category(c.name); }
                }
                Rectangle { vertical-stretch: 1; }
            }
            grid := Rectangle {
                horizontal-stretch: 1;
                clip: true;
                property <int> cols: 3;
                property <length> gap: 14px;
                property <length> tw: (self.width - (self.cols - 1) * self.gap) / self.cols;
                property <length> th: 192px;
                gflick := Flickable {
                    content-height: Math.ceil(root.products.length / grid.cols) * (grid.th + grid.gap) - grid.gap;
                    for p[i] in root.products: Card {
                        x: mod(i, grid.cols) * (grid.tw + grid.gap);
                        y: floor(i / grid.cols) * (grid.th + grid.gap);
                        width: grid.tw;
                        height: grid.th;
                        item: p;
                        picked(pk) => { root.pick(pk); }
                    }
                }
                if gflick.content-height > gflick.height && -gflick.content-y < gflick.content-height - gflick.height - 1px: Rectangle {
                    y: parent.height - 34px;
                    x: (parent.width - 260px) / 2;
                    width: 260px;
                    height: 34px;
                    border-radius: 17px;
                    background: Mk.inkt;
                    Text {
                        text: "↓ more products";
                        color: Mk.wit;
                        font-size: 16px;
                        font-weight: 600;
                    }
                }
            }
            Sheet {
                width: 400px;
                VerticalLayout {
                    padding: 20px;
                    spacing: 12px;
                    HorizontalLayout {
                        Text {
                            text: "Your cart";
                            color: Mk.inkt;
                            font-family: Mk.serif;
                            font-size: 30px;
                            font-weight: 700;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: root.units == 0 ? "" : root.units + (root.units == 1 ? " item" : " items");
                            color: Mk.grafiet;
                            font-size: 17px;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle { height: 1px; background: Mk.lijn; }
                    if root.units == 0: Text {
                        vertical-stretch: 1;
                        text: "Tap a product,\nor scan its barcode.";
                        color: Mk.grafiet;
                        font-size: 22px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    if root.units > 0: Lines {
                        vertical-stretch: 1;
                        rows: root.rows;
                        editable: true;
                        inc(i) => { root.action("inc", i); }
                        dec(i) => { root.action("dec", i); }
                    }
                    Rectangle { height: 1px; background: Mk.lijn; }
                    HorizontalLayout {
                        Text {
                            text: "Total";
                            color: Mk.grafiet;
                            font-size: 20px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: root.volunteer ? "free" : root.total;
                            color: root.volunteer ? Mk.openlab-diep : Mk.inkt;
                            font-family: Mk.serif;
                            font-size: 40px;
                            font-weight: 700;
                        }
                    }
                    Press {
                        text: root.volunteer ? "✓ Volunteer drink" : "Volunteer drink";
                        enabled: root.units > 0;
                        fill: root.volunteer ? Mk.openlab : Mk.wit;
                        ink: Mk.inkt;
                        outline: root.volunteer ? Mk.openlab-diep : Mk.lijn;
                        clicked => { root.action("volunteer", 0); }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        Press {
                            text: "Cancel";
                            width: 120px;
                            enabled: root.units > 0;
                            fill: Mk.wit;
                            ink: Mk.rood;
                            outline: Mk.lijn;
                            clicked => { root.action("cancel", 0); }
                        }
                        Press {
                            text: "Checkout →";
                            enabled: root.units > 0;
                            font-size: 26px;
                            weight: 800;
                            clicked => { root.action("confirm", 0); }
                        }
                    }
                }
            }
        }

        // --- cancel ----------------------------------------------------------
        if root.screen == Screen.cancel-confirm: Dialog {
            title: "Empty the cart?";
            band: #FBEAE8;
            VerticalLayout {
                padding: 40px;
                spacing: 24px;
                Text {
                    vertical-stretch: 1;
                    text: root.units + (root.units == 1 ? " item leaves" : " items leave") + " the cart.\nNothing is taken from stock.";
                    color: Mk.inkt;
                    font-size: 28px;
                    vertical-alignment: center;
                }
                HorizontalLayout {
                    spacing: 20px;
                    Press {
                        text: "← Keep shopping";
                        min-height: 96px;
                        fill: Mk.wit;
                        ink: Mk.inkt;
                        outline: Mk.lijn;
                        font-size: 26px;
                        clicked => { root.action("back", 0); }
                    }
                    Press {
                        text: "Yes, empty it";
                        min-height: 96px;
                        fill: Mk.rood;
                        font-size: 26px;
                        weight: 800;
                        clicked => { root.action("cancel", 0); }
                    }
                }
            }
        }

        // --- checkout / oath -------------------------------------------------
        if root.screen == Screen.checkout-confirm: Dialog {
            title: root.volunteer ? "The volunteer oath" : "Checkout";
            band: root.volunteer ? Mk.openlab : Mk.beton;
            VerticalLayout {
                padding: 32px;
                padding-top: 16px;
                spacing: 16px;
                if root.volunteer: Text {
                    vertical-stretch: 1;
                    text: "“By my honour and the power vested in me, I solemnly swear by the spirit of HTL that I worked well today and deserve a free drink.”";
                    color: Mk.inkt;
                    font-family: Mk.serif;
                    font-size: 30px;
                    font-weight: 500;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }
                if !root.volunteer: Lines {
                    vertical-stretch: 1;
                    rows: root.rows;
                    editable: false;
                }
                HorizontalLayout {
                    Text {
                        text: root.volunteer ? "Normally " + root.total + ", today" : "Removed from stock when you confirm";
                        color: Mk.grafiet;
                        font-size: 19px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: root.volunteer ? "free" : root.total;
                        color: root.volunteer ? Mk.openlab-diep : Mk.inkt;
                        font-family: Mk.serif;
                        font-size: 48px;
                        font-weight: 700;
                    }
                }
                HorizontalLayout {
                    spacing: 16px;
                    Press {
                        text: "← Back";
                        width: 200px;
                        min-height: 88px;
                        fill: Mk.wit;
                        ink: Mk.inkt;
                        outline: Mk.lijn;
                        clicked => { root.action("back", 0); }
                    }
                    Press {
                        text: root.volunteer ? "✓ Volunteer" : "Volunteer";
                        width: 220px;
                        min-height: 88px;
                        fill: root.volunteer ? Mk.openlab : Mk.wit;
                        ink: Mk.inkt;
                        outline: root.volunteer ? Mk.openlab-diep : Mk.lijn;
                        clicked => { root.action("volunteer", 0); }
                    }
                    Press {
                        text: root.volunteer ? "I swear it" : "Confirm & pay";
                        min-height: 88px;
                        font-size: 28px;
                        weight: 800;
                        fill: root.volunteer ? Mk.openlab-diep : Mk.inkt;
                        clicked => { root.action("confirm", 0); }
                    }
                }
            }
        }

        if root.screen == Screen.processing: Text {
            text: "One moment…";
            color: Mk.inkt;
            font-family: Mk.serif;
            font-size: 56px;
            font-weight: 500;
        }

        // --- payment QR ------------------------------------------------------
        if root.screen == Screen.qr: Dialog {
            title: "Pay with Wero";
            band: Mk.workshop;
            HorizontalLayout {
                padding: 32px;
                spacing: 40px;
                Image {
                    width: 420px;
                    source: root.qr;
                    image-fit: contain;
                    image-rendering: pixelated;
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 18px;
                    Text {
                        text: root.total;
                        color: Mk.inkt;
                        font-family: Mk.serif;
                        font-size: 96px;
                        font-weight: 700;
                    }
                    Text {
                        text: "Open your banking app and scan the code. The amount is already filled in.";
                        color: Mk.grafiet;
                        font-size: 22px;
                        wrap: word-wrap;
                    }
                    Text {
                        text: root.cart-categories;
                        color: Mk.grafiet;
                        font-size: 16px;
                        font-weight: 600;
                        overflow: elide;
                    }
                    Press {
                        text: "Done";
                        min-height: 96px;
                        font-size: 30px;
                        weight: 800;
                        accessible-label: "DONE";
                        clicked => { root.action("confirm", 0); }
                    }
                }
            }
        }

        // --- did you pay? ----------------------------------------------------
        if root.screen == Screen.pay-confirm: Dialog {
            title: "Did you pay " + root.total + "?";
            band: Mk.herstel;
            VerticalLayout {
                padding: 40px;
                spacing: 24px;
                Text {
                    vertical-stretch: 1;
                    text: "Only tap Yes once your banking app says the payment went through.";
                    color: Mk.inkt;
                    font-size: 28px;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }
                HorizontalLayout {
                    spacing: 20px;
                    Press {
                        text: "← Not yet";
                        min-height: 110px;
                        fill: Mk.wit;
                        ink: Mk.inkt;
                        outline: Mk.lijn;
                        font-size: 28px;
                        accessible-label: "NOT YET";
                        clicked => { root.action("back", 0); }
                    }
                    Press {
                        text: "Yes, I paid";
                        min-height: 110px;
                        fill: Mk.openlab-diep;
                        font-size: 28px;
                        weight: 800;
                        accessible-label: "YES, I PAID";
                        clicked => { root.action("confirm", 0); }
                    }
                }
            }
        }

        if root.screen == Screen.volunteer-done: Rectangle {
            background: Mk.openlab;
            VerticalLayout {
                alignment: center;
                spacing: 16px;
                Text {
                    text: "Enjoy your drink!";
                    color: Mk.inkt;
                    font-family: Mk.serif;
                    font-size: 72px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.done-summary + " — on the house";
                    color: Mk.openlab-diep;
                    font-size: 28px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }
            }
        }
    }

    if root.searching != "": Rectangle {
        background: #F1F0ECe6;
        TouchArea { }
        VerticalLayout {
            alignment: center;
            spacing: 10px;
            Text {
                text: "Looking it up…";
                color: Mk.inkt;
                font-family: Mk.serif;
                font-size: 52px;
                font-weight: 500;
                horizontal-alignment: center;
            }
            Text {
                text: root.searching;
                color: Mk.grafiet;
                font-family: Mk.mono;
                font-size: 24px;
                horizontal-alignment: center;
            }
        }
    }
}
