// Kiosk UI in the "agenda" style of maakleerplek.be: categories are
// full-height colour bands, cards carry a stripe and a label in their
// category colour, every dialog is an agenda entry with a coloured left
// column. No black surfaces; the main action is workshop blue.

import { Mk, Screen, Category, CartRow, ProductTile, ToolRate, LaserSessionRow, Press } from "tokens.slint";
export { Screen, Category, CartRow, ProductTile, ToolRate, LaserSessionRow }

// Number pad of the grams and minutes screens.
component Keypad inherits Rectangle {
    in-out property <int> value;
    in property <int> max: 9999;
    GridLayout {
        spacing: 8px;
        Row {
            Press { text: "7"; radius: 0px; clicked => { root.value = Math.min(root.value * 10 + 7, root.max); } }
            Press { text: "8"; radius: 0px; clicked => { root.value = Math.min(root.value * 10 + 8, root.max); } }
            Press { text: "9"; radius: 0px; clicked => { root.value = Math.min(root.value * 10 + 9, root.max); } }
        }
        Row {
            Press { text: "4"; radius: 0px; clicked => { root.value = Math.min(root.value * 10 + 4, root.max); } }
            Press { text: "5"; radius: 0px; clicked => { root.value = Math.min(root.value * 10 + 5, root.max); } }
            Press { text: "6"; radius: 0px; clicked => { root.value = Math.min(root.value * 10 + 6, root.max); } }
        }
        Row {
            Press { text: "1"; radius: 0px; clicked => { root.value = Math.min(root.value * 10 + 1, root.max); } }
            Press { text: "2"; radius: 0px; clicked => { root.value = Math.min(root.value * 10 + 2, root.max); } }
            Press { text: "3"; radius: 0px; clicked => { root.value = Math.min(root.value * 10 + 3, root.max); } }
        }
        Row {
            Press { text: "C"; radius: 0px; fill: Mk.wit; ink: Mk.inkt; outline: Mk.lijn; accessible-label: "Clear"; clicked => { root.value = 0; } }
            Press { text: "0"; radius: 0px; clicked => { root.value = Math.min(root.value * 10, root.max); } }
            Press { text: "⌫"; radius: 0px; fill: Mk.wit; ink: Mk.inkt; outline: Mk.lijn; accessible-label: "Delete digit"; clicked => { root.value = floor(root.value / 10); } }
        }
    }
}

component Card inherits Rectangle {
    in property <ProductTile> item;
    /// Picked on the 3D-print screen: a thick border in the tile's colour.
    in property <bool> selected;
    callback picked(int);

    accessible-role: button;
    accessible-label: root.item.name;
    // flash: keeps the tap highlight ~¼ s after release, so a quick tap visibly registered.
    property <bool> flash;
    property <bool> hot: touch.pressed || root.flash;
    background: root.hot ? root.item.light : Mk.wit;
    animate background { duration: 120ms; }
    border-width: root.selected || root.hot ? 5px : 1px;
    border-color: root.selected || root.hot ? root.item.deep : Mk.lijn;
    opacity: root.item.sold-out ? 0.4 : 1;
    clip: true;

    Rectangle { y: 0; height: 8px; background: root.item.deep; }
    VerticalLayout {
        padding: 10px;
        padding-top: 14px;
        spacing: 4px;
        HorizontalLayout {
            height: 24px;
            Rectangle {
                width: label.preferred-width + 14px;
                background: root.item.light;
                label := Text {
                    text: root.item.category;
                    color: root.item.deep;
                    font-size: 12px;
                    font-weight: 800;
                }
            }
            Rectangle { }
        }
        Rectangle {
            height: 60px;
            if root.item.has-image: Image {
                height: parent.height;
                width: parent.width;
                source: root.item.image;
                image-fit: contain;
            }
            if !root.item.has-image: Text {
                text: root.item.initials;
                color: root.item.deep;
                font-family: Mk.serif;
                font-size: 40px;
                font-weight: 700;
            }
        }
        Text {
            text: root.item.name;
            color: Mk.inkt;
            font-size: 17px;
            font-weight: 600;
            wrap: word-wrap;
            overflow: elide;
            height: 40px;
            vertical-alignment: top;
        }
        Text {
            text: root.item.sold-out ? "SOLD OUT" : root.item.price;
            color: root.item.sold-out ? Mk.rood : Mk.inkt;
            font-family: root.item.sold-out ? Mk.sans : Mk.serif;
            font-size: root.item.sold-out ? 16px : 26px;
            font-weight: 700;
        }
    }

    if root.item.in-cart > 0: Rectangle {
        x: parent.width - 44px;
        y: 8px;
        width: 44px;
        height: 40px;
        background: root.item.deep;
        Text {
            text: "×" + root.item.in-cart;
            color: Mk.wit;
            font-size: 18px;
            font-weight: 800;
        }
    }

    touch := TouchArea {
        enabled: !root.item.sold-out;
        clicked => { root.flash = true; root.picked(root.item.pk); }
    }
    Timer { interval: 250ms; running: root.flash; triggered => { root.flash = false; } }
}

component Entries inherits Rectangle {
    in property <[CartRow]> rows;
    in property <bool> editable;
    property <length> row-h: root.editable ? 76px : 54px;
    callback inc(int);
    callback dec(int);
    clip: true;

    flick := Flickable {
        content-height: root.rows.length * root.row-h;
        for row[i] in root.rows: Rectangle {
            y: i * root.row-h;
            height: root.row-h - 6px;
            background: Mk.wit;
            HorizontalLayout {
                spacing: 12px;
                padding-right: 6px;
                Rectangle {
                    width: 58px;
                    background: row.deep;
                    Text {
                        text: row.qty;
                        color: Mk.wit;
                        font-family: Mk.serif;
                        font-size: 28px;
                        font-weight: 700;
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    Text {
                        text: row.name;
                        color: Mk.inkt;
                        font-size: root.editable ? 17px : 20px;
                        font-weight: 600;
                        overflow: elide;
                    }
                    if root.editable: Text {
                        text: row.price;
                        color: Mk.grafiet;
                        font-size: 16px;
                    }
                }
                if !root.editable: Text {
                    text: row.price;
                    color: Mk.inkt;
                    font-family: Mk.serif;
                    font-size: 24px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                if root.editable: Press {
                    text: "−";
                    width: 58px;
                    min-height: 58px;
                    radius: 0px;
                    y: (parent.height - 58px) / 2;
                    fill: Mk.wit;
                    ink: Mk.inkt;
                    outline: Mk.grafiet;
                    font-size: 28px;
                    accessible-label: "minus " + row.name;
                    clicked => { root.dec(i); }
                }
                if root.editable && row.whole: Rectangle { width: 58px; }
                if root.editable && !row.whole: Press {
                    text: "+";
                    width: 58px;
                    min-height: 58px;
                    radius: 0px;
                    y: (parent.height - 58px) / 2;
                    fill: Mk.workshop-diep;
                    font-size: 28px;
                    accessible-label: "plus " + row.name;
                    clicked => { root.inc(i); }
                }
            }
        }
    }

    if flick.content-height > flick.height && -flick.content-y < flick.content-height - flick.height - 1px: Rectangle {
        y: parent.height - 28px;
        height: 28px;
        background: Mk.beton-donker;
        Text {
            text: "MORE ↓";
            color: Mk.grafiet;
            font-size: 14px;
            font-weight: 800;
        }
    }
}

// Agenda entry: coloured left column with the title, white content right.
component Entry inherits Rectangle {
    in property <string> kicker;
    in property <string> title;
    in property <color> light: Mk.beton-donker;
    in property <color> deep: Mk.inkt;
    background: Mk.wit;
    HorizontalLayout {
        Rectangle {
            width: 380px;
            background: root.light;
            Rectangle { x: 0; width: 14px; background: root.deep; }
            VerticalLayout {
                padding: 40px;
                padding-left: 54px;
                spacing: 12px;
                alignment: end;
                Text {
                    text: root.kicker;
                    color: root.deep;
                    font-size: 18px;
                    font-weight: 800;
                }
                Text {
                    text: root.title;
                    color: Mk.inkt;
                    font-family: Mk.serif;
                    font-size: 54px;
                    font-weight: 700;
                    wrap: word-wrap;
                }
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            @children
        }
    }
}

export component AppWindow inherits Window {
    title: "interface-stock";
    width: 1280px;
    height: 720px;
    background: Mk.wit;
    default-font-family: Mk.sans;

    in property <Screen> screen: Screen.shop;
    in property <string> htl-name;
    in property <string> message;
    in property <bool> message-error;
    in property <string> searching;
    in property <[CartRow]> rows;
    in property <int> units;
    in property <string> total;
    in property <bool> volunteer;
    in property <image> qr;
    in property <string> cart-categories;
    in property <string> done-summary;
    in property <[Category]> categories;
    in-out property <string> category: "ALL";
    in property <[ProductTile]> all-products;
    in property <[ProductTile]> products;
    // 3D print: filaments (price per gram), and the screen's own state.
    in property <[ProductTile]> filaments;
    in-out property <bool> print-open: false;
    in property <[ProductTile]> filament-types;
    // The chosen type's colours, filtered by the Rust glue (refilter_colours) like the shop grid.
    in property <[ProductTile]> print-colours;
    in-out property <string> print-type;
    in-out property <int> print-type-pk: -1;
    in-out property <string> print-type-price;
    in-out property <int> print-pk: -1;
    in-out property <string> print-name;
    in-out property <string> print-colour-price;
    in-out property <int> print-grams: 0;
    // Machine time: the machines (price per minute, minimum), and the minutes screen's state.
    in property <[ToolRate]> tools;
    // Open laser timer sessions, paid with one tap on the LASERCUT screen.
    in property <[LaserSessionRow]> laser-sessions;
    in-out property <bool> time-open: false;
    in-out property <string> time-id;
    in-out property <string> time-name;
    in-out property <float> time-per-minute;
    in-out property <float> time-minimum;
    in-out property <int> time-minutes: 0;
    // "For volunteers only" pop-up before VOLUNTEER turns on, so a visitor does not tap it by accident.
    in-out property <bool> volunteer-ask: false;
    property <float> time-price: root.time-minutes > 0 ? Math.max(root.time-minutes * root.time-per-minute, root.time-minimum) : 0;

    callback action(string, int);
    callback pick(int);
    callback select-category(string);
    callback select-print-type(string);

    // --- ink top bar -------------------------------------------------------
    Rectangle {
        y: 0;
        height: 72px;
        background: Mk.wit;
        Rectangle { y: parent.height - 1px; height: 1px; background: Mk.lijn; }
        HorizontalLayout {
            padding-left: 24px;
            padding-right: 12px;
            padding-top: 8px;
            padding-bottom: 8px;
            spacing: 16px;
            Image {
                source: @image-url("assets/wordmark-ink.png");
                width: 210px;
                image-fit: contain;
            }
            Rectangle {
                horizontal-stretch: 1;
                if root.message != "": Rectangle {
                    width: min(parent.width, 640px);
                    height: 44px;
                    background: root.message-error ? Mk.rood : Mk.openlab;
                    Text {
                        width: parent.width - 28px;
                        text: root.message;
                        color: root.message-error ? Mk.wit : Mk.inkt;
                        font-size: 19px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        overflow: elide;
                    }
                }
            }
            Text {
                text: "TV PAGE";
                color: Mk.grafiet;
                font-size: 14px;
                font-weight: 800;
                vertical-alignment: center;
            }
            Press {
                text: "◀";
                width: 64px;
                min-height: 56px;
                radius: 0px;
                fill: Mk.wit;
                ink: Mk.inkt;
                outline: Mk.lijn;
                font-size: 20px;
                accessible-label: "TV previous page";
                clicked => { root.action("page-prev", 0); }
            }
            Press {
                text: "▶";
                width: 64px;
                min-height: 56px;
                radius: 0px;
                fill: Mk.wit;
                ink: Mk.inkt;
                outline: Mk.lijn;
                font-size: 20px;
                accessible-label: "TV next page";
                clicked => { root.action("page-next", 0); }
            }
        }
    }

    body := Rectangle {
        y: 72px;
        height: root.height - 72px;

        // --- shop: bands | cards | cart ------------------------------------
        // Gone while the 3D-print or minutes screen covers it: no hidden buttons under them.
        if root.screen == Screen.shop && !root.print-open && !root.time-open: HorizontalLayout {
            VerticalLayout {
                width: 200px;
                for c in root.categories: Rectangle {
                    accessible-role: button;
                    accessible-label: c.name;
                    min-height: 72px;
                    max-height: 132px;
                    vertical-stretch: 1;
                    background: band-touch.pressed ? c.light.darker(25%) : c.light;
                    Rectangle {
                        x: 0;
                        width: c.name == root.category ? 16px : 0px;
                        background: c.deep;
                    }
                    Text {
                        x: 30px;
                        y: parent.height - self.height - 16px;
                        text: c.name;
                        color: c.deep;
                        font-size: 22px;
                        font-weight: 800;
                    }
                    if c.name == root.category: Text {
                        x: parent.width - 34px;
                        y: 14px;
                        text: "●";
                        color: Mk.inkt;
                        font-size: 16px;
                    }
                    Rectangle { y: parent.height - 1px; height: 1px; background: #00000022; }
                    band-touch := TouchArea {
                        clicked => { root.select-category(c.name); }
                    }
                }
                Rectangle { background: Mk.beton; vertical-stretch: 0.01; }
                if root.filaments.length > 0: Rectangle {
                    accessible-role: button;
                    accessible-label: "3D print";
                    min-height: 72px;
                    max-height: 132px;
                    vertical-stretch: 1;
                    background: print-touch.pressed ? Mk.workshop-diep.darker(25%) : Mk.workshop-diep;
                    Text {
                        x: 30px;
                        y: parent.height - self.height - 16px;
                        text: "3D PRINT";
                        color: Mk.wit;
                        font-size: 22px;
                        font-weight: 800;
                    }
                    print-touch := TouchArea {
                        clicked => {
                            root.print-pk = -1;
                            root.select-print-type("");
                            root.print-type-pk = -1;
                            root.print-grams = 0;
                            root.print-open = true;
                        }
                    }
                }
                for t in root.tools: Rectangle {
                    accessible-role: button;
                    accessible-label: t.name;
                    min-height: 72px;
                    max-height: 132px;
                    vertical-stretch: 1;
                    property <color> deep: t.id == "laser" ? #A8401A : #34505E;
                    background: tool-touch.pressed ? self.deep.darker(25%) : self.deep;
                    Rectangle { y: 0; height: 1px; background: #ffffff33; }
                    Text {
                        x: 30px;
                        y: parent.height - self.height - 16px;
                        text: t.name;
                        color: Mk.wit;
                        font-size: 22px;
                        font-weight: 800;
                    }
                    tool-touch := TouchArea {
                        clicked => {
                            root.time-id = t.id;
                            root.time-name = t.name;
                            root.time-per-minute = t.per-minute;
                            root.time-minimum = t.minimum;
                            root.time-minutes = 0;
                            root.time-open = true;
                        }
                    }
                }
            }
            grid := Rectangle {
                horizontal-stretch: 1;
                clip: true;
                property <int> cols: 3;
                property <length> pad: 16px;
                property <length> gap: 12px;
                property <length> tw: (self.width - 2 * self.pad - (self.cols - 1) * self.gap) / self.cols;
                property <length> th: 194px;
                gflick := Flickable {
                    x: grid.pad;
                    y: grid.pad;
                    width: grid.width - 2 * grid.pad;
                    height: grid.height - grid.pad;
                    content-height: Math.ceil(root.products.length / grid.cols) * (grid.th + grid.gap);
                    for p[i] in root.products: Card {
                        x: mod(i, grid.cols) * (grid.tw + grid.gap);
                        y: floor(i / grid.cols) * (grid.th + grid.gap);
                        width: grid.tw;
                        height: grid.th;
                        item: p;
                        picked(pk) => { root.pick(pk); }
                    }
                }
                if gflick.content-height > gflick.height && -gflick.content-y < gflick.content-height - gflick.height - 1px: Rectangle {
                    y: parent.height - 24px;
                    height: 24px;
                    background: Mk.beton-donker;
                    Text {
                        text: "MORE PRODUCTS ↓";
                        color: Mk.grafiet;
                        font-size: 14px;
                        font-weight: 800;
                    }
                }
            }
            Rectangle {
                width: 390px;
                background: Mk.beton;
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    HorizontalLayout {
                        Text {
                            text: "CART";
                            color: Mk.inkt;
                            font-size: 20px;
                            font-weight: 800;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: root.units == 0 ? "empty" : root.units + (root.units == 1 ? " item" : " items");
                            color: Mk.grafiet;
                            font-size: 16px;
                        }
                    }
                    if root.units == 0: Rectangle {
                        vertical-stretch: 1;
                        border-width: 2px;
                        border-color: Mk.lijn;
                        Text {
                            width: parent.width - 40px;
                            text: "Tap a product on the left, or scan its barcode.";
                            color: Mk.grafiet;
                            font-size: 20px;
                            wrap: word-wrap;
                            horizontal-alignment: center;
                        }
                    }
                    if root.units > 0: Entries {
                        vertical-stretch: 1;
                        rows: root.rows;
                        editable: true;
                        inc(i) => { root.action("inc", i); }
                        dec(i) => { root.action("dec", i); }
                    }
                    HorizontalLayout {
                        Text {
                            text: "TOTAL";
                            color: Mk.grafiet;
                            font-size: 16px;
                            font-weight: 800;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: root.volunteer ? "Free" : root.total;
                            color: root.volunteer ? Mk.openlab-diep : Mk.inkt;
                            font-family: Mk.serif;
                            font-size: 48px;
                            font-weight: 700;
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Press {
                            text: root.volunteer ? "✓ VOLUNTEER" : "VOLUNTEER";
                            enabled: root.units > 0;
                            radius: 0px;
                            fill: Mk.openlab;
                            ink: Mk.openlab-diep;
                            outline: root.volunteer ? Mk.openlab-diep : transparent;
                            outline-w: 3px;
                            font-size: 18px;
                            weight: 800;
                            accessible-label: root.volunteer ? "VOLUNTEER: FREE" : "VOLUNTEER DRINK";
                            clicked => { if (root.volunteer) { root.action("volunteer", 0); } else { root.volunteer-ask = true; } }
                        }
                        Press {
                            text: "CANCEL";
                            width: 130px;
                            enabled: root.units > 0;
                            radius: 0px;
                            fill: Mk.wit;
                            ink: Mk.rood;
                            outline: Mk.rood;
                            font-size: 18px;
                            weight: 800;
                            clicked => { root.action("cancel", 0); }
                        }
                    }
                    Press {
                        text: "CHECKOUT  →";
                        enabled: root.units > 0;
                        min-height: 84px;
                        radius: 0px;
                        fill: Mk.workshop-diep;
                        font-size: 26px;
                        weight: 800;
                        clicked => { root.action("confirm", 0); }
                    }
                }
            }
        }

        // --- cancel ----------------------------------------------------------
        // --- 3D print: the type, then its colour (both optional), the grams --
        if root.screen == Screen.shop && root.print-open: Rectangle {
            background: Mk.beton;
            TouchArea { }   // nothing behind it reacts while it is open
            HorizontalLayout {
                padding: 16px;
                spacing: 16px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 10px;
                    Text { text: "1. WHICH FILAMENT? (OPTIONAL)"; color: Mk.inkt; font-size: 20px; font-weight: 800; }
                    HorizontalLayout {
                        spacing: 8px;
                        height: 80px;
                        for t in root.filament-types: Press {
                            text: t.name;
                            radius: 0px;
                            font-size: 22px;
                            fill: t.name == root.print-type ? Mk.workshop-diep : Mk.wit;
                            ink: t.name == root.print-type ? Mk.wit : Mk.inkt;
                            outline: Mk.lijn;
                            clicked => {
                                if (root.print-type == t.name) {
                                    root.select-print-type("");
                                    root.print-type-pk = -1;
                                } else {
                                    root.select-print-type(t.name);
                                    root.print-type-pk = t.pk;
                                    root.print-type-price = t.price;
                                }
                                root.print-pk = -1;
                            }
                        }
                    }
                    Text {
                        text: root.print-type == "" ? "Pick a type to choose its colour, or just type the grams." : "2. WHICH COLOUR? (OPTIONAL)";
                        color: root.print-type == "" ? Mk.grafiet : Mk.inkt;
                        font-size: root.print-type == "" ? 16px : 20px;
                        font-weight: root.print-type == "" ? 400 : 800;
                    }
                    // The colours as the shop's tiles, 4 to a row.
                    colours := Rectangle {
                        vertical-stretch: 1;
                        clip: true;
                        property <int> cols: 4;
                        property <length> gap: 10px;
                        property <length> tw: (self.width - (self.cols - 1) * self.gap) / self.cols;
                        property <length> th: 194px;
                        Flickable {
                            content-height: Math.ceil(root.print-colours.length / colours.cols) * (colours.th + colours.gap);
                            for f[i] in root.print-colours: Card {
                                x: mod(i, colours.cols) * (colours.tw + colours.gap);
                                y: floor(i / colours.cols) * (colours.th + colours.gap);
                                width: colours.tw;
                                height: colours.th;
                                item: f;
                                selected: f.pk == root.print-pk;
                                picked(pk) => {
                                    if (root.print-pk == pk) {
                                        root.print-pk = -1;
                                    } else {
                                        root.print-pk = pk;
                                        root.print-name = f.name;
                                        root.print-colour-price = f.price;
                                    }
                                }
                            }
                        }
                    }
                }
                VerticalLayout {
                    width: 380px;
                    spacing: 8px;
                    Text { text: "HOW MANY GRAMS?"; color: Mk.inkt; font-size: 20px; font-weight: 800; }
                    Text { text: "The weight Bambu Studio / PrusaSlicer shows for your print."; color: Mk.grafiet; font-size: 14px; wrap: word-wrap; }
                    Rectangle {
                        height: 72px;
                        background: Mk.wit;
                        Text {
                            text: root.print-grams + " g";
                            color: Mk.inkt;
                            font-size: 40px;
                            font-weight: 800;
                        }
                    }
                    Keypad { value <=> root.print-grams; }
                    Text {
                        text: root.print-pk >= 0 ? root.print-type + " " + root.print-name + " · " + root.print-colour-price
                            : root.print-type != "" ? root.print-type + ", no colour · " + root.print-type-price
                            : "No filament picked: booked without one, at the standard price.";
                        color: Mk.grafiet;
                        font-size: 15px;
                        wrap: word-wrap;
                    }
                    Press {
                        text: "ADD TO CART";
                        radius: 0px;
                        enabled: root.print-grams > 0;
                        fill: Mk.workshop-diep;
                        clicked => {
                            root.action(root.print-pk >= 0 ? "print:" + root.print-pk : root.print-type-pk >= 0 ? "print-type:" + root.print-type-pk : "print:none", root.print-grams);
                            root.print-open = false;
                        }
                    }
                    Press {
                        text: "CANCEL";
                        radius: 0px;
                        fill: Mk.wit;
                        ink: Mk.inkt;
                        outline: Mk.lijn;
                        clicked => { root.print-open = false; }
                    }
                }
            }
        }

        // --- machine time: type the minutes, add to the cart ----------------
        if root.screen == Screen.shop && root.time-open: Rectangle {
            background: Mk.beton;
            TouchArea { }   // nothing behind it reacts while it is open
            HorizontalLayout {
                padding: 16px;
                spacing: 16px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 12px;
                    Text { text: root.time-name + " · HOW MANY MINUTES?"; color: Mk.inkt; font-size: 28px; font-weight: 800; wrap: word-wrap; }
                    Text {
                        text: root.time-id == "laser" ? "The minutes the laser ran for your job: the time on the laser timer." : "The minutes the CNC ran for your job.";
                        color: Mk.grafiet;
                        font-size: 18px;
                        wrap: word-wrap;
                    }
                    Text {
                        text: "€" + root.time-per-minute.to-fixed(2) + " per minute" + (root.time-minimum > 0 ? " · minimum €" + root.time-minimum.to-fixed(2) + " per job" : "");
                        color: Mk.inkt;
                        font-size: 20px;
                        wrap: word-wrap;
                    }
                    if root.time-id == "laser" && root.laser-sessions.length > 0: Text {
                        text: "YOUR SESSION ON THE LASER TIMER? TAP IT TO PAY:";
                        color: Mk.inkt;
                        font-size: 16px;
                        font-weight: 800;
                    }
                    if root.time-id == "laser": Flickable {
                        height: root.laser-sessions.length > 0 ? min(3, root.laser-sessions.length) * 72px : 0;
                        VerticalLayout {
                            alignment: start;
                            spacing: 8px;
                            for s[i] in root.laser-sessions: Press {
                                text: s.name + "  ·  " + s.minutes + " min  ·  " + s.price;
                                min-height: 64px;
                                radius: 0px;
                                font-size: 20px;
                                fill: #A8401A;
                                clicked => {
                                    root.action("session:" + i, 0);
                                    root.time-open = false;
                                }
                            }
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                    Text { text: "TO PAY"; color: Mk.grafiet; font-size: 16px; font-weight: 800; }
                    Text { text: "€" + root.time-price.to-fixed(2); color: Mk.inkt; font-size: 56px; font-weight: 800; }
                    Text {
                        text: root.time-minutes > 0 && root.time-minutes * root.time-per-minute < root.time-minimum ? "Under the minimum: you pay the minimum per job." : " ";
                        color: Mk.grafiet;
                        font-size: 16px;
                    }
                }
                VerticalLayout {
                    width: 380px;
                    spacing: 8px;
                    Rectangle {
                        height: 72px;
                        background: Mk.wit;
                        Text { text: root.time-minutes + " min"; color: Mk.inkt; font-size: 40px; font-weight: 800; }
                    }
                    Keypad { value <=> root.time-minutes; max: 999; }
                    Press {
                        text: "ADD TO CART";
                        radius: 0px;
                        enabled: root.time-minutes > 0;
                        fill: Mk.workshop-diep;
                        clicked => {
                            root.action("time:" + root.time-id, root.time-minutes);
                            root.time-open = false;
                        }
                    }
                    Press {
                        text: "CANCEL";
                        radius: 0px;
                        fill: Mk.wit;
                        ink: Mk.inkt;
                        outline: Mk.lijn;
                        clicked => { root.time-open = false; }
                    }
                }
            }
        }

        if root.screen == Screen.cancel-confirm: Entry {
            kicker: "CANCEL";
            title: "Empty the cart?";
            light: #FBEAE8;
            deep: Mk.rood;
            VerticalLayout {
                padding: 48px;
                spacing: 24px;
                Text {
                    vertical-stretch: 1;
                    text: root.units + (root.units == 1 ? " item leaves" : " items leave") + " the cart. Nothing is taken from stock.";
                    color: Mk.inkt;
                    font-size: 28px;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }
                HorizontalLayout {
                    spacing: 16px;
                    Press {
                        text: "← KEEP SHOPPING";
                        min-height: 100px;
                        radius: 0px;
                        fill: Mk.wit;
                        ink: Mk.inkt;
                        outline: Mk.grafiet;
                        font-size: 22px;
                        weight: 800;
                        clicked => { root.action("back", 0); }
                    }
                    Press {
                        text: "YES, EMPTY IT";
                        min-height: 100px;
                        radius: 0px;
                        fill: Mk.rood;
                        font-size: 22px;
                        weight: 800;
                        clicked => { root.action("cancel", 0); }
                    }
                }
            }
        }

        // --- checkout / oath -------------------------------------------------
        if root.screen == Screen.checkout-confirm: Entry {
            kicker: root.volunteer ? "VOLUNTEER" : "STEP 1 OF 2";
            title: root.volunteer ? "The oath" : "Check your cart";
            light: root.volunteer ? Mk.openlab : Mk.herstel;
            deep: root.volunteer ? Mk.openlab-diep : Mk.herstel-diep;
            VerticalLayout {
                padding: 32px;
                spacing: 14px;
                if root.volunteer: Text {
                    vertical-stretch: 1;
                    text: "By my honour and the power vested in me, I solemnly swear by the spirit of HTL that I am a volunteer and that this is fair: a drink I earned, or material and machine time for me or for the lab.";
                    color: Mk.inkt;
                    font-family: Mk.serif;
                    font-size: 30px;
                    font-weight: 500;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }
                if !root.volunteer: Entries {
                    vertical-stretch: 1;
                    rows: root.rows;
                    editable: false;
                }
                HorizontalLayout {
                    Text {
                        text: root.volunteer ? "NORMALLY " + root.total : "TOTAL";
                        color: Mk.grafiet;
                        font-size: 16px;
                        font-weight: 800;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: root.volunteer ? "Free" : root.total;
                        color: root.volunteer ? Mk.openlab-diep : Mk.inkt;
                        font-family: Mk.serif;
                        font-size: 52px;
                        font-weight: 700;
                    }
                }
                HorizontalLayout {
                    spacing: 12px;
                    Press {
                        text: "← BACK";
                        width: 150px;
                        min-height: 88px;
                        radius: 0px;
                        fill: Mk.wit;
                        ink: Mk.inkt;
                        outline: Mk.grafiet;
                        font-size: 20px;
                        weight: 800;
                        clicked => { root.action("back", 0); }
                    }
                    Press {
                        text: root.volunteer ? "✓ VOLUNTEER" : "VOLUNTEER";
                        width: 190px;
                        min-height: 88px;
                        radius: 0px;
                        fill: Mk.openlab;
                        ink: Mk.openlab-diep;
                        font-size: 20px;
                        weight: 800;
                        clicked => { if (root.volunteer) { root.action("volunteer", 0); } else { root.volunteer-ask = true; } }
                    }
                    Press {
                        text: root.volunteer ? "I SWEAR IT" : "CONFIRM & PAY →";
                        min-height: 88px;
                        radius: 0px;
                        fill: root.volunteer ? Mk.openlab-diep : Mk.workshop-diep;
                        font-size: 24px;
                        weight: 800;
                        clicked => { root.action("confirm", 0); }
                    }
                }
            }
        }

        if root.screen == Screen.processing: Entry {
            kicker: "ONE MOMENT";
            title: "Booking…";
            light: Mk.workshop;
            deep: Mk.workshop-diep;
        }

        // --- payment QR ------------------------------------------------------
        // The QR stays visible behind the "did you pay?" pop-up.
        if root.screen == Screen.qr || root.screen == Screen.pay-confirm: Entry {
            kicker: "STEP 2 OF 2";
            title: "Pay " + root.total;
            light: Mk.workshop;
            deep: Mk.workshop-diep;
            HorizontalLayout {
                padding: 32px;
                spacing: 32px;
                Image {
                    width: 440px;
                    source: root.qr;
                    image-fit: contain;
                    image-rendering: pixelated;
                }
                VerticalLayout {
                    alignment: end;
                    spacing: 16px;
                    Text {
                        text: "Scan with Wero or your banking app. The amount is filled in.";
                        color: Mk.inkt;
                        font-size: 22px;
                        wrap: word-wrap;
                    }
                    Text {
                        text: root.cart-categories;
                        color: Mk.grafiet;
                        font-size: 14px;
                        font-weight: 800;
                        wrap: word-wrap;
                    }
                    Press {
                        text: "DONE";
                        min-height: 110px;
                        radius: 0px;
                        fill: Mk.workshop-diep;
                        font-size: 30px;
                        weight: 800;
                        clicked => { root.action("confirm", 0); }
                    }
                }
            }
        }

        if root.screen == Screen.volunteer-done: Entry {
            kicker: "THANK YOU";
            title: "Booked as volunteer use. Enjoy!";
            light: Mk.openlab;
            deep: Mk.openlab-diep;
            Text {
                x: 48px;
                text: root.done-summary + " — on the house";
                color: Mk.openlab-diep;
                font-family: Mk.serif;
                font-size: 40px;
                font-weight: 700;
            }
        }
    }

    if root.searching != "": Rectangle {
        background: #ffffffe6;
        TouchArea { }
        VerticalLayout {
            alignment: center;
            spacing: 10px;
            Text {
                text: "LOOKING IT UP";
                color: Mk.workshop-diep;
                font-size: 22px;
                font-weight: 800;
                horizontal-alignment: center;
            }
            Text {
                text: root.searching;
                color: Mk.inkt;
                font-family: Mk.serif;
                font-size: 56px;
                font-weight: 700;
                horizontal-alignment: center;
            }
        }
    }

    // --- did you pay? -------------------------------------------------------
    // YES unlocks after a countdown (state.rs PAY_CONFIRM_LOCK, enforced there too),
    // so a double tap on DONE can't book the payment.
    if root.screen == Screen.pay-confirm: Rectangle {
        property <int> left: 3;
        background: #000000aa;
        TouchArea { }   // nothing behind it reacts while it is open
        Timer { interval: 1s; running: left > 0; triggered => { left -= 1; } }
        Rectangle {
            width: 760px;
            height: 440px;
            background: Mk.wit;
            border-width: 4px;
            border-color: Mk.herstel-diep;
            VerticalLayout {
                padding: 36px;
                spacing: 18px;
                Text { text: "LAST CHECK"; color: Mk.herstel-diep; font-size: 20px; font-weight: 800; }
                Text { text: "Did you pay " + root.total + "?"; color: Mk.inkt; font-family: Mk.serif; font-size: 40px; font-weight: 700; wrap: word-wrap; }
                Text {
                    text: "Only tap YES once your banking app says the payment went through.";
                    color: Mk.inkt;
                    font-size: 22px;
                    wrap: word-wrap;
                    vertical-stretch: 1;
                }
                HorizontalLayout {
                    spacing: 16px;
                    Press {
                        text: "← NOT YET";
                        min-height: 100px;
                        radius: 0px;
                        fill: Mk.wit;
                        ink: Mk.inkt;
                        outline: Mk.grafiet;
                        font-size: 24px;
                        weight: 800;
                        clicked => { root.action("back", 0); }
                    }
                    Press {
                        text: left > 0 ? "YES, I PAID (" + left + ")" : "YES, I PAID";
                        accessible-label: "YES, I PAID";
                        enabled: left == 0;
                        min-height: 100px;
                        radius: 0px;
                        fill: Mk.openlab-diep;
                        font-size: 24px;
                        weight: 800;
                        clicked => { root.action("confirm", 0); }
                    }
                }
            }
        }
    }

    // --- before VOLUNTEER turns on: who it is for ---------------------------
    if root.volunteer-ask: Rectangle {
        background: #000000aa;
        TouchArea { }   // nothing behind it reacts while it is open
        Rectangle {
            width: 760px;
            height: 420px;
            background: Mk.wit;
            border-width: 4px;
            border-color: Mk.openlab-diep;
            VerticalLayout {
                padding: 36px;
                spacing: 18px;
                Text { text: "FOR VOLUNTEERS ONLY"; color: Mk.openlab-diep; font-size: 20px; font-weight: 800; }
                Text { text: "Are you an HTL volunteer?"; color: Mk.inkt; font-size: 36px; font-weight: 800; wrap: word-wrap; }
                Text {
                    text: "Volunteer mode makes the cart free: a drink you earned, or material and machine time for yourself or for the lab. It is booked as volunteer use.\nVisitors pay as usual: tap BACK.";
                    color: Mk.inkt;
                    font-size: 20px;
                    wrap: word-wrap;
                    vertical-stretch: 1;
                }
                HorizontalLayout {
                    spacing: 12px;
                    Press {
                        text: "← BACK";
                        radius: 0px;
                        fill: Mk.wit;
                        ink: Mk.inkt;
                        outline: Mk.lijn;
                        accessible-label: "Back, I am not a volunteer";
                        clicked => { root.volunteer-ask = false; }
                    }
                    Press {
                        text: "YES, I'M A VOLUNTEER";
                        radius: 0px;
                        fill: Mk.openlab-diep;
                        clicked => {
                            root.volunteer-ask = false;
                            root.action("volunteer", 0);
                        }
                    }
                }
            }
        }
    }
}
