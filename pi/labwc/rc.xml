<?xml version="1.0"?>
<!-- labwc for the kiosk: touch goes to the Touch Display, each app to its own screen. The kiosk sets no app_id (winit), so match its title. -->
<labwc_config>
  <touch mapToOutput="DSI-1" mouseEmulation="no" />
  <windowRules>
    <windowRule title="interface-stock" serverDecoration="no">
      <action name="MoveToOutput" output="DSI-1" />
      <action name="ToggleFullscreen" />
    </windowRule>
    <!-- chrom*: in --app mode Chromium on Wayland is "chrome-...", not "chromium". -->
    <windowRule identifier="chrom*" serverDecoration="no">
      <action name="MoveToOutput" output="HDMI-A-1" />
    </windowRule>
  </windowRules>
</labwc_config>
