# InvenTree Configuration Template
# Copy this file to .env and fill in your actual credentials

INVENTREE_URL=http://10.72.1.246:80
INVENTREE_TOKEN=your_token_here

# Payment Information (Wero/EPC QR codes)
VITE_PAYMENT_NAME=Your Makerspace Name
VITE_PAYMENT_IBAN=BE00000000000000

# Optional: HTL/Makerspace Information (fallback if VITE_ vars not set)
HTL_NAME=HTL Makerspace
HTL_CODE=HTL001

# TV screen (Tv-Presentation): every checkout and volunteer drink is posted to
# its Recent activity panel. Without it the TV only sees stock drop and shows
# every volunteer drink as a paid purchase.
TV_PRESENTATION_URL=http://10.72.1.246:8083
